# 必填：访问密码
PASSWORD=change-me

# 可选：宿主机媒体库根目录（映射到容器 /media）
# MEDIA_ROOT=/Volumes/extend/大眼橙

# 下载默认目录（容器内路径）
# DOWNLOAD_MOVIES_DIR=/media/Movies
# DOWNLOAD_TV_DIR=/media/TVShows
# DOWNLOAD_ALLOW_ROOTS=/media
# DOWNLOAD_STATE_FILE=/data/state/downloads.json
# DOWNLOAD_CONCURRENCY=2
# DOWNLOAD_EPISODE_CONCURRENCY=4
# DOWNLOAD_SEGMENT_CONCURRENCY=12
# DOWNLOAD_GLOBAL_SEGMENT_CONCURRENCY=24
# DOWNLOAD_ENGINE=segments
# DOWNLOAD_RETRIES=3
# DOWNLOAD_KEEP_SEGS=0

# ---- Emby：下载完成后增量刷新（可选）----
# API Key 创建：Emby 管理后台 → 设置 → API 密钥 → 新建 → 把 Access Token 整串贴到 EMBY_API_KEY
# 直达（需已登录管理员）：http://localhost:8096/web/index.html#!/apikeys
# EMBY_URL=http://host.docker.internal:8096
# EMBY_API_KEY=
# EMBY_PATH_MAP=/media/Movies:/mnt/movies,/media/TVShows:/mnt/tv

REQUEST_TIMEOUT=30000
MAX_RETRIES=3
SEARCH_MAX_PAGES=3
SEARCH_SOURCE_TIMEOUT_MS=20000

# PROXY_SECRET=
# COOKIE_SECURE=
# DEBUG=false
